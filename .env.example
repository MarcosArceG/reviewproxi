# App
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:pass@localhost:5432/reviewproxi

# Cron diario (Vercel inyecta Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Clerk (inicio de sesión embebido en /sign-in, en español)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# Gemini (borradores de respuesta a reseñas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Demo: importación de reseñas vía Apify (hasta aprobación Google)
APIFY_TOKEN=
APIFY_ACTOR_ID=compass/google-maps-reviews-scraper

# Google Business Profile API (respuestas reales en Maps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=
